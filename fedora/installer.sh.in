#!/usr/bin/env bash
# PJH Desk for Fedora — 이 파일 하나로 설치가 끝난다(앱과 PJH-LOCK이 안에 들어 있다).
#   bash pjh-desk-fedora.run                 설치 (또는 업데이트) 후 바로 실행
#   bash pjh-desk-fedora.run --no-lock       PJH-LOCK(GNOME 잠금 화면) 없이 설치
#   bash pjh-desk-fedora.run --no-autostart  로그인할 때 자동 실행 끄기
#   bash pjh-desk-fedora.run --uninstall     제거 (PJH-LOCK도 원래 설정으로 되돌림)
#
# 관리자 권한 없이 내 계정 안에만 설치한다:
#   앱     ~/.local/share/pjh-desk
#   앱 목록 ~/.local/share/applications/pjh-desk.desktop
#   자동 실행 ~/.config/autostart/pjh-desk.desktop

set -euo pipefail

VERSION="@@VERSION@@"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
APP_DIR="$DATA_HOME/pjh-desk"
DESKTOP_FILE="$DATA_HOME/applications/pjh-desk.desktop"
AUTOSTART_FILE="$CONFIG_HOME/autostart/pjh-desk.desktop"
ICON_FILE="$DATA_HOME/icons/hicolor/256x256/apps/pjh-desk.png"

say()  { printf '\033[1m%s\033[0m\n' "$*"; }
info() { printf '  %s\n' "$*"; }
die()  { printf '\033[31m오류:\033[0m %s\n' "$*" >&2; exit 1; }

usage() { sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; }

desktop_entry() {
    cat <<EOF
[Desktop Entry]
Type=Application
Name=PJH Desk
Comment=바탕화면 위젯 - 시계, 날씨, 할 일, 뉴스, 시스템 상태
Exec="$APP_DIR/pjh-desk"
Icon=pjh-desk
Terminal=false
Categories=Utility;
StartupWMClass=pjh-desk
EOF
}

extract_payload() {
    local line
    line=$(awk '/^__PJH_PAYLOAD__$/ { print NR + 1; exit 0 }' "$0")
    [[ -n "$line" ]] || die "설치 파일이 손상됐어요(내용물을 찾을 수 없음)."
    tail -n +"$line" "$0" | tar -x -C "$1"
}

install() {
    [[ "$(id -u)" -ne 0 ]] || die "sudo 없이 내 계정으로 실행해 주세요."
    [[ "$(uname -m)" == "x86_64" ]] || die "64비트(x86_64) 리눅스에서만 동작해요. 지금은 $(uname -m) 이에요."

    say "PJH Desk $VERSION 설치"
    # 임시 폴더는 전역 변수로 둔다(함수가 끝난 뒤 EXIT 정리에서도 보이게).
    TMP_DIR="$(mktemp -d)"
    trap 'rm -rf "${TMP_DIR:-}"' EXIT
    local tmp="$TMP_DIR"
    extract_payload "$tmp"
    mkdir -p "$tmp/app"
    tar -xzf "$tmp/app.tar.gz" -C "$tmp/app" --strip-components=1

    # 실행 중이면 끄고 바꾼다.
    pkill -f "$APP_DIR/pjh-desk" 2>/dev/null || true
    sleep 1

    rm -rf "$APP_DIR"
    mkdir -p "$(dirname "$APP_DIR")"
    mv "$tmp/app" "$APP_DIR"
    # Windows에서 만든 압축이라 실행 권한이 없다. 직접 붙인다.
    chmod +x "$APP_DIR/pjh-desk" "$APP_DIR/chrome_crashpad_handler" "$APP_DIR/chrome-sandbox"
    cp "$tmp/pjh-lock-fedora.sh" "$APP_DIR/pjh-lock-fedora.sh"
    info "앱 설치: $APP_DIR"

    mkdir -p "$(dirname "$ICON_FILE")" "$(dirname "$DESKTOP_FILE")"
    cp "$tmp/icon.png" "$ICON_FILE"
    desktop_entry > "$DESKTOP_FILE"
    command -v update-desktop-database >/dev/null && update-desktop-database "$(dirname "$DESKTOP_FILE")" 2>/dev/null || true
    info "앱 목록에 등록 (활동 화면에서 'PJH Desk' 검색)"

    if (( AUTOSTART )); then
        mkdir -p "$(dirname "$AUTOSTART_FILE")"
        { desktop_entry; echo "X-GNOME-Autostart-enabled=true"; } > "$AUTOSTART_FILE"
        info "로그인할 때 자동 실행"
    else
        rm -f "$AUTOSTART_FILE"
        info "자동 실행 꺼짐"
    fi

    if (( WITH_LOCK )); then
        echo
        bash "$APP_DIR/pjh-lock-fedora.sh" || info "PJH-LOCK 설치는 건너뛰었어요(GNOME이 아니거나 오류)."
    fi

    echo
    say "설치 완료. PJH Desk를 실행해요."
    nohup "$APP_DIR/pjh-desk" >/dev/null 2>&1 &
    info "다시 열기: 활동 화면에서 'PJH Desk' · 제거: bash $(basename "$0") --uninstall"
}

uninstall() {
    say "PJH Desk 제거"
    pkill -f "$APP_DIR/pjh-desk" 2>/dev/null || true
    if [[ -f "$APP_DIR/pjh-lock-fedora.sh" ]]; then
        bash "$APP_DIR/pjh-lock-fedora.sh" --uninstall || true
    fi
    rm -rf "$APP_DIR"
    rm -f "$DESKTOP_FILE" "$AUTOSTART_FILE" "$ICON_FILE"
    command -v update-desktop-database >/dev/null && update-desktop-database "$(dirname "$DESKTOP_FILE")" 2>/dev/null || true
    info "앱, 앱 목록, 자동 실행 삭제 (설정·할 일은 ~/.config/pjh-desk 에 남겨 둬요)"
    say "제거 완료."
}

ACTION=install
WITH_LOCK=1
AUTOSTART=1
while (( $# )); do
    case "$1" in
        --uninstall|-u)  ACTION=uninstall ;;
        --no-lock)       WITH_LOCK=0 ;;
        --no-autostart)  AUTOSTART=0 ;;
        --help|-h)       usage; exit 0 ;;
        *)               die "알 수 없는 옵션: $1 (도움말: --help)" ;;
    esac
    shift
done

case "$ACTION" in
    install)   install ;;
    uninstall) uninstall ;;
esac
exit 0
__PJH_PAYLOAD__
