{
  "name": "pjh-desk",
  "version": "2.0.0",
  "description": "PJH 바탕화면 위젯 - 시계, 날씨, 오늘 할 일, 헤드라인(BBC 한국/세계, Hacker News)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "set ELECTRON_BUILDER_COMPRESSION_LEVEL=5&& electron-builder --win portable"
  },
  "author": "박준현",
  "license": "UNLICENSED",
  "dependencies": {
    "fast-xml-parser": "^4.5.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pjh.desk",
    "productName": "PJH Desk",
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "modules/**/*",
      "src/**/*",
      "assets/**/*"
    ],
    "icon": "assets/icon.png",
    "win": {
      "target": ["portable", "nsis"],
      "extraResources": [
        { "from": "../PJH-LOCK/bin/PJH-LOCK.exe", "to": "PJH-LOCK.exe" }
      ]
    },
    "portable": {
      "artifactName": "PJH-Desk.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "PJH-Desk-Setup.exe"
    },
    "linux": {
      "target": ["AppImage", "rpm"],
      "category": "Utility"
    }
  }
}
